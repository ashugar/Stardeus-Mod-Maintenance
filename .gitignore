# Generated build and editor state. Keep .vscode source/project files.
/*/bin/
/*/obj/
/*/.vscode/bin/
/*/.vscode/obj/
/*/Tests/bin/
/*/Tests/obj/
**/.vs/
**/__pycache__/
*.user
*.suo
*.pdb
*.pyc
*.pyo
*.deps.json

# Backups, temporary files, and generated diagnostics.
/QuantumStorage/PanelDiagnostics.enabled
**/.release*/
*.bak
*.bak.*
*.backup
*.backup.*
*.old
*.old.*
*.orig
*.orig.*
*.tmp
*.log
/AutoHauling/.vscode/Backups/

# Repository-only development tool and harness outputs.
/.build/
/build/**/bin/
/build/**/obj/
