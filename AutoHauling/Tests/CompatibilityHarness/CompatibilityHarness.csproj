<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil" HintPath="$(CecilPath)" />
  </ItemGroup>
  <Target Name="RequireCecil" BeforeTargets="ResolveReferences" Condition="!Exists('$(CecilPath)')">
    <Error Text="Supply -p:CecilPath pointing to a local Mono.Cecil.dll." />
  </Target>
</Project>
