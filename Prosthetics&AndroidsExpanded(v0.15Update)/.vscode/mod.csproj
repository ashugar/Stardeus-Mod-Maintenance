<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <OutputType>Library</OutputType>
    <TargetFramework>net481</TargetFramework>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>ProstheticsAndroidsExpanded</RootNamespace>
    <AssemblyName>ProstheticsAndroidsExpanded</AssemblyName>
    <OutputPath>../Libraries</OutputPath>
    <VersionPrefix>2.3.4.0</VersionPrefix>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoConfig>true</NoConfig>
    <NoStdLib>true</NoStdLib>
    <AddAdditionalExplicitAssemblyReferences>false</AddAdditionalExplicitAssemblyReferences>
    <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
    <ImplicitlyExpandDesignTimeFacades>false</ImplicitlyExpandDesignTimeFacades>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Code/**/*.cs" />
    <Reference Include="Game">
      <HintPath>$(StardeusManagedPath)\Game.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Constants">
      <HintPath>$(StardeusManagedPath)\Game.Constants.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Utils">
      <HintPath>$(StardeusManagedPath)\Game.Utils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="KLUnityUtils">
      <HintPath>$(StardeusManagedPath)\KLUnityUtils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(StardeusManagedPath)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="mscorlib">
      <HintPath>$(StardeusManagedPath)\mscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System">
      <HintPath>$(StardeusManagedPath)\System.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(StardeusManagedPath)\System.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
