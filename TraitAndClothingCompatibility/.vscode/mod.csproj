<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <TargetFramework>net481</TargetFramework>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TraitAndClothingCompatibility</RootNamespace>
    <AssemblyName>TraitAndClothingCompatibility</AssemblyName>
    <VersionPrefix>1.1.5</VersionPrefix>
    <AssemblyVersion>1.1.5.0</AssemblyVersion>
    <FileVersion>1.1.5.0</FileVersion>
    <InformationalVersion>1.1.5</InformationalVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <OutputPath>../Libraries</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoConfig>true</NoConfig>
    <NoStdLib>true</NoStdLib>
    <AddAdditionalExplicitAssemblyReferences>false</AddAdditionalExplicitAssemblyReferences>
    <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
    <ImplicitlyExpandDesignTimeFacades>false</ImplicitlyExpandDesignTimeFacades>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/BaselineTraits.json" LogicalName="TACC.BaselineTraits.json" />
    <EmbeddedResource Include="Resources/BaselineExpandedTraits.json" LogicalName="TACC.BaselineExpandedTraits.json" />
    <EmbeddedResource Include="Resources/BaselineEquipment.json" LogicalName="TACC.BaselineEquipment.json" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net481" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="AutoUtilitiesModFramework" HintPath="$(AumfDll)" Private="False" />
    <Reference Include="0Harmony" HintPath="$(StardeusManagedPath)/0Harmony.dll" Private="False" />
    <Reference Include="Game" HintPath="$(StardeusManagedPath)/Game.dll" Private="False" />
    <Reference Include="Game.Constants" HintPath="$(StardeusManagedPath)/Game.Constants.dll" Private="False" />
    <Reference Include="Game.Utils" HintPath="$(StardeusManagedPath)/Game.Utils.dll" Private="False" />
    <Reference Include="KLUnityUtils" HintPath="$(StardeusManagedPath)/KLUnityUtils.dll" Private="False" />
    <Reference Include="Newtonsoft.Json" HintPath="$(StardeusManagedPath)/Newtonsoft.Json.dll" Private="False" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(StardeusManagedPath)/Unity.TextMeshPro.dll" Private="False" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(StardeusManagedPath)/UnityEngine.CoreModule.dll" Private="False" />
    <Reference Include="UnityEngine.UI" HintPath="$(StardeusManagedPath)/UnityEngine.UI.dll" Private="False" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(StardeusManagedPath)/UnityEngine.UIModule.dll" Private="False" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(StardeusManagedPath)/UnityEngine.IMGUIModule.dll" Private="False" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(StardeusManagedPath)/UnityEngine.TextRenderingModule.dll" Private="False" />
    <Reference Include="mscorlib" HintPath="$(StardeusManagedPath)/mscorlib.dll" Private="False" />
    <Reference Include="netstandard" HintPath="$(StardeusManagedPath)/netstandard.dll" Private="False" />
    <Reference Include="System" HintPath="$(StardeusManagedPath)/System.dll" Private="False" />
    <Reference Include="System.Core" HintPath="$(StardeusManagedPath)/System.Core.dll" Private="False" />
  </ItemGroup>
</Project>
